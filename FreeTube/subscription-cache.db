ntent.com/ytc/AIdro_ndlyiwFocsh_Mh0rWQSGYxJNFFLPIqHsKzBl2e3g_rPQw=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"//yt3.googleusercontent.com/ytc/AIdro_ndlyiwFocsh_Mh0rWQSGYxJNFFLPIqHsKzBl2e3g_rPQw=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1661562972386,"voteCount":10,"postContent":null,"commentCount":1,"authorId":"UC4W2HJ_NVHmMCBl_e_WFnCA","author":"Plasmyte","type":"community"},{"postText":"The editing process for the next video is currently underway, it won&apos;t be remotely as long as the Attack on Titan video but it will still be a rather in depth look into a series that we&apos;ve already covered on the channel before, hope everyone is looking forward to it!","postId":"Ugkx40b-iHgmRt1oi1tNMLlzdxwAtJGXv1T_","authorThumbnails":[{"url":"//yt3.googleusercontent.com/ytc/AIdro_ndlyiwFocsh_Mh0rWQSGYxJNFFLPIqHsKzBl2e3g_rPQw=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"//yt3.googleusercontent.com/ytc/AIdro_ndlyiwFocsh_Mh0rWQSGYxJNFFLPIqHsKzBl2e3g_rPQw=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"//yt3.googleusercontent.com/ytc/AIdro_ndlyiwFocsh_Mh0rWQSGYxJNFFLPIqHsKzBl2e3g_rPQw=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1661562972386,"voteCount":12,"postContent":null,"commentCount":2,"authorId":"UC4W2HJ_NVHmMCBl_e_WFnCA","author":"Plasmyte","type":"community"},{"postText":"Please remember to share our newest video if you enjoyed it! It took up a lot of time and energy and frankly we&apos;d like as wide an audience to see it as possible to promote discussion and more videos like it in the future! :)","postId":"UgkxGEe2ckRgWsU0esJS6L97mEKwvE4YYYC8","authorThumbnails":[{"url":"//yt3.googleusercontent.com/ytc/AIdro_ndlyiwFocsh_Mh0rWQSGYxJNFFLPIqHsKzBl2e3g_rPQw=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"//yt3.googleusercontent.com/ytc/AIdro_ndlyiwFocsh_Mh0rWQSGYxJNFFLPIqHsKzBl2e3g_rPQw=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"//yt3.googleusercontent.com/ytc/AIdro_ndlyiwFocsh_Mh0rWQSGYxJNFFLPIqHsKzBl2e3g_rPQw=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1661562972386,"voteCount":15,"postContent":{"type":"video","content":{"type":"video","videoId":"Hr44dBCWcHY","title":"The Ultimate Critique of Attack on Titan's Ending","author":"Plasmyte","authorId":"UC4W2HJ_NVHmMCBl_e_WFnCA","description":"This is a video essay and overall critique of the ending for Attack on Titan and contains MAJOR spoilers for the entire series. Note that this video was also created before the conclusion of...","viewCount":106933,"published":1661562972386,"lengthSeconds":7298,"liveNow":false,"isUpcoming":false,"is4k":false,"is8k":false,"isNew":false,"isVr180":false,"isVr360":false,"is3d":false,"hasCaptions":false}},"commentCount":4,"authorId":"UC4W2HJ_NVHmMCBl_e_WFnCA","author":"Plasmyte","type":"community"},{"postText":"Hello everyone, I hope you&apos;ve all had an amazing start to the new year, and with that being said, I come with some very good news about the progress of our next video!\n\nAs far as production goes, the video is essentially COMPLETE! However I will be dedicating the next day or two to ironing out a few wrinkles in the video concerning copyright issues.\n\nThis is the biggest (and potentially most controversial) video we&apos;ve ever produced, clocking in at about 2 hours long and I am eternally grateful to FuchsiaFree for opting to narrate the last few sections in my stead as I&apos;ve been unable to over the last few months, as well as another friend of mines who wishes to remain unnamed for editing together the last few sections in my place as I had no access to my PC.\n\nThis video means a lot to me, it came around during a very difficult time of my life and faced frequent delays due to my unprecedented circumstances, so it would mean the world to me if you guys could share it with your friends as wide as you can.\n\nThank you all for bearing with me, and I hope you all have a lovely 2022!\n\n-jitterbug","postId":"UgkxuK558my5ThbW1mdRsuVZsQbZ3TYYkIYl","authorThumbnails":[{"url":"//yt3.googleusercontent.com/ytc/AIdro_ndlyiwFocsh_Mh0rWQSGYxJNFFLPIqHsKzBl2e3g_rPQw=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"//yt3.googleusercontent.com/ytc/AIdro_ndlyiwFocsh_Mh0rWQSGYxJNFFLPIqHsKzBl2e3g_rPQw=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"//yt3.googleusercontent.com/ytc/AIdro_ndlyiwFocsh_Mh0rWQSGYxJNFFLPIqHsKzBl2e3g_rPQw=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1661562972388,"voteCount":11,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/n_TgsV2M6U_-Tawr-HcYRLjogeNheJFiPbjKXsp7jjWTjEQUwXifE-uDxvVZ9z9W1AQK5OqI1oWzEA=s311-c-fcrop64=1,30100000cfefffff-nd-v1-rwa","width":311,"height":311}]},"commentCount":1,"authorId":"UC4W2HJ_NVHmMCBl_e_WFnCA","author":"Plasmyte","type":"community"}],"communityPostsTimestamp":{"$$date":1756233828390}}
